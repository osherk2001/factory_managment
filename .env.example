# Local development values. Replace the placeholder password if exposing PostgreSQL beyond localhost.
POSTGRES_DB=factoryflow
POSTGRES_USER=factoryflow
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://factoryflow:replace-with-local-password@localhost:5432/factoryflow?schema=public
LOG_LEVEL=info
PORT=3000
AUTH_SECRET=replace-with-at-least-32-random-characters
# Required by the development-only fixture seed command.
SEED_ENV=development
