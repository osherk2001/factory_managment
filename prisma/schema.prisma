generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  CREATED
  IN_PROGRESS
  READY_FOR_HANDOFF
  COMPLETED
  CANCELLED
  TRASHED
}

enum LocationType {
  DEPARTMENT
  WORK_AREA
  SAFE
  STORAGE
  WAITING
  EXTERNAL
  OTHER
}

enum IssueStatus {
  OPEN
  RESOLVED
}

enum WeightEventType {
  EXPECTED
  ISSUED
  FINAL
  RETURNED
  APPROVED_LOSS
  CORRECTION
}

enum AssignmentEndReason {
  FINISHED
  TAKEN_OVER
  CANCELLED
  COMPLETED
  MANUAL_TRANSFER
}

enum ProductTransitionEventType {
  PRODUCT_CREATED
  PRODUCT_RECEIVED
  WORK_FINISHED
  RESPONSIBILITY_TAKEN_OVER
  PRODUCT_COMPLETED
  PRODUCT_RETURNED_TO_PROCESS
  PRODUCT_CANCELLED
  PRODUCT_RESTORED
  PRODUCT_TRASHED
  MANUAL_TRANSFER
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  slug      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  memberships             Membership[]
  accessRoles             AccessRole[]
  employeeProfiles        EmployeeProfile[]
  productionRoles         ProductionRole[]
  departments             Department[]
  locations               Location[]
  customers               Customer[]
  productionOrders        ProductionOrder[]
  productTypes            ProductType[]
  products                Product[]
  barcodes                Barcode[]
  workflowTemplates       WorkflowTemplate[]
  workflowSnapshots       WorkflowSnapshot[]
  workflowTemplateStages  WorkflowTemplateStage[]
  workflowSnapshotStages  WorkflowSnapshotStage[]
  productAssignments      ProductAssignment[]
  productTransitions      ProductTransition[]
  issues                  Issue[]
  weightEvents            WeightEvent[]
  auditLogs               AuditLog[]
  idempotencyKeys         IdempotencyKey[]
  membershipAccessRoles   MembershipAccessRole[]
  employeeProductionRoles EmployeeProductionRole[]
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  username      String?  @unique @db.VarChar(100)
  email         String?  @unique @db.VarChar(320)
  passwordHash  String?  @db.VarChar(255)
  isActive      Boolean  @default(true)
  isSystemAdmin Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  memberships               Membership[]
  productTransitionsAsActor ProductTransition[] @relation("ProductTransitionActors")
  auditLogsAsActor          AuditLog[]          @relation("AuditLogActors")
  issuesReported            Issue[]             @relation("IssueReporters")
  issuesResolved            Issue[]             @relation("IssueResolvers")
  weightEventsRecorded      WeightEvent[]       @relation("WeightEventRecorders")
  idempotencyKeys           IdempotencyKey[]
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  status         String   @db.VarChar(32)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  employeeProfile EmployeeProfile?
  accessRoleLinks MembershipAccessRole[]
  productTransitionsAsActor      ProductTransition[] @relation("ProductTransitionActorMembership")
  issuesReportedAsActor          Issue[]             @relation("IssueReporterMemberships")
  issuesResolvedAsActor          Issue[]             @relation("IssueResolverMemberships")
  weightEventsRecordedAsActor    WeightEvent[]       @relation("WeightEventRecorderMemberships")
  auditLogsAsActorMembership     AuditLog[]          @relation("AuditLogActorMemberships")
  idempotencyKeysAsActor         IdempotencyKey[]    @relation("IdempotencyKeyActorMemberships")

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@unique([organizationId, id, userId])
  @@index([userId])
  @@index([organizationId, status])
}

model AccessRole {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  code            String   @db.VarChar(100)
  name            String   @db.VarChar(200)
  isSystemDefined Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissionLinks AccessRolePermission[]
  membershipLinks MembershipAccessRole[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  accessRoleLinks AccessRolePermission[]
}

model AccessRolePermission {
  accessRoleId String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  accessRole AccessRole @relation(fields: [accessRoleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([accessRoleId, permissionId])
  @@index([permissionId])
}

model MembershipAccessRole {
  organizationId String   @db.Uuid
  membershipId   String   @db.Uuid
  accessRoleId   String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership   Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  accessRole   AccessRole   @relation(fields: [organizationId, accessRoleId], references: [organizationId, id], onDelete: Restrict)

  @@id([membershipId, accessRoleId])
  @@index([organizationId])
  @@index([accessRoleId])
}

model EmployeeProfile {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  membershipId   String   @db.Uuid
  displayName    String   @db.VarChar(200)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership          Membership               @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  productionRoleLinks EmployeeProductionRole[]
  assignments         ProductAssignment[]
  currentProducts     Product[]                @relation("ProductCurrentWorker")
  transitionsFrom     ProductTransition[]      @relation("ProductTransitionFromWorkers")
  transitionsTo       ProductTransition[]      @relation("ProductTransitionToWorkers")
  weightEvents        WeightEvent[]

  @@unique([organizationId, membershipId])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
}

model ProductionRole {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @db.VarChar(100)
  name           String   @db.VarChar(200)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeLinks          EmployeeProductionRole[]
  workflowTemplateStages WorkflowTemplateStage[]
  workflowSnapshotStages WorkflowSnapshotStage[]
  assignments            ProductAssignment[]
  currentProducts        Product[]                @relation("ProductCurrentRole")
  transitionsFrom        ProductTransition[]      @relation("ProductTransitionFromRoles")
  transitionsTo          ProductTransition[]      @relation("ProductTransitionToRoles")
  weightEvents           WeightEvent[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
}

model EmployeeProductionRole {
  organizationId   String   @db.Uuid
  employeeId       String   @db.Uuid
  productionRoleId String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee       EmployeeProfile @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  productionRole ProductionRole  @relation(fields: [organizationId, productionRoleId], references: [organizationId, id], onDelete: Restrict)

  @@id([employeeId, productionRoleId])
  @@index([organizationId])
  @@index([productionRoleId])
}

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @db.VarChar(100)
  name           String   @db.VarChar(200)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locations    Location[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
}

model Location {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  departmentId   String?      @db.Uuid
  code           String       @db.VarChar(100)
  name           String       @db.VarChar(200)
  type           LocationType
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department      Department?         @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict)
  currentProducts Product[]           @relation("ProductCurrentLocation")
  assignments     ProductAssignment[]
  transitionsFrom ProductTransition[] @relation("ProductTransitionFromLocations")
  transitionsTo   ProductTransition[] @relation("ProductTransitionToLocations")

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, departmentId])
  @@index([organizationId, type, isActive])
}

model Customer {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  name              String   @db.VarChar(200)
  externalReference String?  @db.VarChar(200)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productionOrders ProductionOrder[]

  @@unique([organizationId, id])
  @@index([organizationId, name])
}

model ProductionOrder {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  customerId     String?   @db.Uuid
  orderNumber    String    @db.VarChar(100)
  status         String    @db.VarChar(50)
  commitmentAt   DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer?    @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, orderNumber])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
}

model ProductType {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @db.VarChar(100)
  name           String   @db.VarChar(200)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @db.Uuid
  productionOrderId String?       @db.Uuid
  productTypeId     String?       @db.Uuid
  serialNumber      String        @db.VarChar(100)
  status            ProductStatus
  currentWorkerId   String?       @db.Uuid
  currentRoleId     String?       @db.Uuid
  currentLocationId String?       @db.Uuid
  currentStageId    String?       @db.Uuid
  isUrgent          Boolean       @default(false)
  targetAt          DateTime?     @db.Timestamptz(6)
  completedAt       DateTime?     @db.Timestamptz(6)
  cancelledAt       DateTime?     @db.Timestamptz(6)
  trashedAt         DateTime?     @db.Timestamptz(6)
  version           Int           @default(0)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productionOrder  ProductionOrder?       @relation(fields: [organizationId, productionOrderId], references: [organizationId, id], onDelete: Restrict)
  productType      ProductType?           @relation(fields: [organizationId, productTypeId], references: [organizationId, id], onDelete: Restrict)
  currentWorker    EmployeeProfile?       @relation("ProductCurrentWorker", fields: [organizationId, currentWorkerId], references: [organizationId, id], onDelete: Restrict)
  currentRole      ProductionRole?        @relation("ProductCurrentRole", fields: [organizationId, currentRoleId], references: [organizationId, id], onDelete: Restrict)
  currentLocation  Location?              @relation("ProductCurrentLocation", fields: [organizationId, currentLocationId], references: [organizationId, id], onDelete: Restrict)
  currentStage     WorkflowSnapshotStage? @relation("ProductCurrentStage", fields: [organizationId, id, currentStageId], references: [organizationId, productId, id], onDelete: Restrict)
  workflowSnapshot WorkflowSnapshot?
  barcode          Barcode?
  assignments      ProductAssignment[]
  transitions      ProductTransition[]
  issues           Issue[]
  weightEvents     WeightEvent[]

  @@unique([organizationId, serialNumber])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, currentWorkerId, status])
  @@index([organizationId, currentRoleId, status])
  @@index([organizationId, currentLocationId, status])
  @@index([organizationId, targetAt])
  @@index([organizationId, productionOrderId])
}

model Barcode {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  productId      String    @unique @db.Uuid
  value          String    @unique @db.VarChar(255)
  format         String?   @db.VarChar(50)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  lastPrintedAt  DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, productId])
  @@index([organizationId, productId])
}

model WorkflowTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(200)
  version        Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stages       WorkflowTemplateStage[]
  snapshots    WorkflowSnapshot[]

  @@unique([organizationId, name, version])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
}

model WorkflowTemplateStage {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  workflowTemplateId String   @db.Uuid
  productionRoleId   String?  @db.Uuid
  code               String   @db.VarChar(100)
  name               String   @db.VarChar(200)
  position           Int?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflowTemplate WorkflowTemplate        @relation(fields: [organizationId, workflowTemplateId], references: [organizationId, id], onDelete: Restrict)
  productionRole   ProductionRole?         @relation(fields: [organizationId, productionRoleId], references: [organizationId, id], onDelete: Restrict)
  snapshotStages   WorkflowSnapshotStage[]

  @@unique([workflowTemplateId, code])
  @@unique([organizationId, id])
  @@index([organizationId, workflowTemplateId, position])
  @@index([organizationId, productionRoleId])
}

model WorkflowSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  productId        String   @db.Uuid
  sourceTemplateId String?  @db.Uuid
  sourceVersion    Int?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product        Product                 @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  sourceTemplate WorkflowTemplate?       @relation(fields: [organizationId, sourceTemplateId], references: [organizationId, id], onDelete: Restrict)
  stages         WorkflowSnapshotStage[]

  @@unique([productId])
  @@unique([organizationId, productId])
  @@unique([organizationId, id])
  @@unique([organizationId, id, productId])
  @@index([organizationId, sourceTemplateId])
}

model WorkflowSnapshotStage {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  workflowSnapshotId String   @db.Uuid
  productId          String   @db.Uuid
  productionRoleId   String?  @db.Uuid
  sourceStageId      String?  @db.Uuid
  code               String   @db.VarChar(100)
  name               String   @db.VarChar(200)
  position           Int?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflowSnapshot WorkflowSnapshot       @relation(fields: [organizationId, workflowSnapshotId, productId], references: [organizationId, id, productId], onDelete: Restrict)
  productionRole   ProductionRole?        @relation(fields: [organizationId, productionRoleId], references: [organizationId, id], onDelete: Restrict)
  sourceStage      WorkflowTemplateStage? @relation(fields: [organizationId, sourceStageId], references: [organizationId, id], onDelete: Restrict)
  currentProducts  Product[]              @relation("ProductCurrentStage")
  assignments      ProductAssignment[]
  transitionsFrom  ProductTransition[]    @relation("ProductTransitionFromStages")
  transitionsTo    ProductTransition[]    @relation("ProductTransitionToStages")

  @@unique([workflowSnapshotId, code])
  @@unique([organizationId, id])
  @@unique([organizationId, productId, id])
  @@index([organizationId, workflowSnapshotId, position])
  @@index([organizationId, productionRoleId])
}

model ProductAssignment {
  // The one-active-assignment invariant is enforced by the PostgreSQL partial
  // unique index in the initial migration.
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @db.Uuid
  productId        String               @db.Uuid
  employeeId       String               @db.Uuid
  productionRoleId String               @db.Uuid
  locationId       String?              @db.Uuid
  workflowStageId  String?              @db.Uuid
  startedAt        DateTime             @default(now()) @db.Timestamptz(6)
  endedAt          DateTime?            @db.Timestamptz(6)
  endReason        AssignmentEndReason?
  createdAt        DateTime             @default(now()) @db.Timestamptz(6)

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product        Product                @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  employee       EmployeeProfile        @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  productionRole ProductionRole         @relation(fields: [organizationId, productionRoleId], references: [organizationId, id], onDelete: Restrict)
  location       Location?              @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  workflowStage  WorkflowSnapshotStage? @relation(fields: [organizationId, productId, workflowStageId], references: [organizationId, productId, id], onDelete: Restrict)

  @@index([organizationId, productId, startedAt])
  @@index([organizationId, employeeId, endedAt])
  @@index([organizationId, productionRoleId, endedAt])
}

model ProductTransition {
  id                String                     @id @default(uuid()) @db.Uuid
  organizationId    String                     @db.Uuid
  productId         String                     @db.Uuid
  actorUserId       String                     @db.Uuid
  actorMembershipId String                     @db.Uuid
  eventType      ProductTransitionEventType
  fromStatus     ProductStatus?
  toStatus       ProductStatus?
  fromWorkerId   String?                    @db.Uuid
  toWorkerId     String?                    @db.Uuid
  fromRoleId     String?                    @db.Uuid
  toRoleId       String?                    @db.Uuid
  fromLocationId String?                    @db.Uuid
  toLocationId   String?                    @db.Uuid
  fromStageId    String?                    @db.Uuid
  toStageId      String?                    @db.Uuid
  reason         String?                    @db.Text
  metadata       Json?                      @db.JsonB
  occurredAt     DateTime                   @default(now()) @db.Timestamptz(6)
  createdAt      DateTime                   @default(now()) @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product                @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  actorUser    User                   @relation("ProductTransitionActors", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorMembership Membership          @relation("ProductTransitionActorMembership", fields: [organizationId, actorMembershipId, actorUserId], references: [organizationId, id, userId], onDelete: Restrict)
  fromWorker   EmployeeProfile?       @relation("ProductTransitionFromWorkers", fields: [organizationId, fromWorkerId], references: [organizationId, id], onDelete: Restrict)
  toWorker     EmployeeProfile?       @relation("ProductTransitionToWorkers", fields: [organizationId, toWorkerId], references: [organizationId, id], onDelete: Restrict)
  fromRole     ProductionRole?        @relation("ProductTransitionFromRoles", fields: [organizationId, fromRoleId], references: [organizationId, id], onDelete: Restrict)
  toRole       ProductionRole?        @relation("ProductTransitionToRoles", fields: [organizationId, toRoleId], references: [organizationId, id], onDelete: Restrict)
  fromLocation Location?              @relation("ProductTransitionFromLocations", fields: [organizationId, fromLocationId], references: [organizationId, id], onDelete: Restrict)
  toLocation   Location?              @relation("ProductTransitionToLocations", fields: [organizationId, toLocationId], references: [organizationId, id], onDelete: Restrict)
  fromStage    WorkflowSnapshotStage? @relation("ProductTransitionFromStages", fields: [organizationId, productId, fromStageId], references: [organizationId, productId, id], onDelete: Restrict)
  toStage      WorkflowSnapshotStage? @relation("ProductTransitionToStages", fields: [organizationId, productId, toStageId], references: [organizationId, productId, id], onDelete: Restrict)

  @@index([organizationId, productId, occurredAt])
  @@index([organizationId, actorUserId, occurredAt])
  @@index([organizationId, eventType, occurredAt])
}

model Issue {
  id                     String      @id @default(uuid()) @db.Uuid
  organizationId         String      @db.Uuid
  productId              String      @db.Uuid
  reportedByUserId       String      @db.Uuid
  reportedByMembershipId String      @db.Uuid
  resolvedByUserId       String?     @db.Uuid
  resolvedByMembershipId String?     @db.Uuid
  type                   String      @db.VarChar(100)
  description            String?     @db.Text
  status                 IssueStatus
  createdAt              DateTime    @default(now()) @db.Timestamptz(6)
  resolvedAt             DateTime?   @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product        Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  reportedByUser User         @relation("IssueReporters", fields: [reportedByUserId], references: [id], onDelete: Restrict)
  reportedByMembership Membership  @relation("IssueReporterMemberships", fields: [organizationId, reportedByMembershipId, reportedByUserId], references: [organizationId, id, userId], onDelete: Restrict)
  resolvedByUser User?        @relation("IssueResolvers", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedByMembership Membership? @relation("IssueResolverMemberships", fields: [organizationId, resolvedByMembershipId, resolvedByUserId], references: [organizationId, id, userId], onDelete: Restrict)

  @@index([organizationId, productId, status])
  @@index([organizationId, status])
}

model WeightEvent {
  id                    String          @id @default(uuid()) @db.Uuid
  organizationId        String          @db.Uuid
  productId             String          @db.Uuid
  recordedByUserId      String          @db.Uuid
  recordedByMembershipId String         @db.Uuid
  employeeId            String?         @db.Uuid
  productionRoleId      String?         @db.Uuid
  type                  WeightEventType
  grams                 Decimal         @db.Decimal(10, 3)
  note                  String?         @db.Text
  occurredAt            DateTime        @default(now()) @db.Timestamptz(6)
  createdAt             DateTime        @default(now()) @db.Timestamptz(6)

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product        Product          @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  recordedByUser User             @relation("WeightEventRecorders", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  recordedByMembership Membership @relation("WeightEventRecorderMemberships", fields: [organizationId, recordedByMembershipId, recordedByUserId], references: [organizationId, id, userId], onDelete: Restrict)
  employee       EmployeeProfile? @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  productionRole ProductionRole?  @relation(fields: [organizationId, productionRoleId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, productId, occurredAt])
  @@index([organizationId, employeeId, occurredAt])
}

model AuditLog {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String?  @db.Uuid
  actorUserId       String?  @db.Uuid
  actorMembershipId String?  @db.Uuid
  action            String   @db.VarChar(150)
  targetType        String   @db.VarChar(100)
  targetId          String?  @db.Uuid
  beforeData        Json?    @db.JsonB
  afterData         Json?    @db.JsonB
  metadata          Json?    @db.JsonB
  occurredAt        DateTime @default(now()) @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser    User?         @relation("AuditLogActors", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMembership Membership? @relation("AuditLogActorMemberships", fields: [organizationId, actorMembershipId, actorUserId], references: [organizationId, id, userId], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([targetType, targetId, occurredAt])
}

model IdempotencyKey {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  userId            String    @db.Uuid
  actorMembershipId String    @db.Uuid
  key               String    @db.VarChar(255)
  operation         String    @db.VarChar(150)
  requestHash       String?   @db.VarChar(128)
  resultReference   String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt         DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  actorMembership Membership @relation("IdempotencyKeyActorMemberships", fields: [organizationId, actorMembershipId, userId], references: [organizationId, id, userId], onDelete: Restrict)

  @@unique([organizationId, userId, key])
  @@index([organizationId, expiresAt])
}
